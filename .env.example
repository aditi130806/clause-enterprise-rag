# CLAUSE Enterprise RAG Configuration

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_LLM_TEMPERATURE=0.0

# Document Processing Defaults
DEFAULT_CHUNK_SIZE=700
DEFAULT_CHUNK_OVERLAP=120

# Vector Store and Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTORSTORE_DIR=vectorstore

# Optional Portable Cache Directory (e.g. D:/clause_cache on storage-constrained environments)
CLAUSE_CACHE_DIR=

# Evidence Sufficiency Gate Thresholds
SUFFICIENCY_MIN_SCORE=0.015
SUFFICIENCY_MIN_CHUNKS=1

# Environment Mode
APP_ENV=development
